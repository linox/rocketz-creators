rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DENY ALL BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTH HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // COLLECTIONS

    // Creators Casting & Profiles (Public read for casting/portfolio, create for signup, update/delete when signed in)
    match /creators/{creatorId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Companies (Create for landing page leads & registration, read for dashboards/portfolios, update/delete when signed in)
    match /companies/{companyId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Campaigns & Subcollections
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();

      match /creators/{campaignCreatorId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // Global Campaign Creators participations
    match /campaignCreators/{ccId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Notifications (Create for event triggers/leads, read/update/delete for signed-in users)
    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }

    // Company Users mapping
    match /companyUsers/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn();
    }

    // Recurring Contracts
    match /recurringContracts/{contractId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Content Planning items
    match /contentPlanning/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // System settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Media files and video chunks for durable persistence
    match /media_files/{mediaId} {
      allow read: if true;
      allow write: if true;

      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Health / Test connection document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

