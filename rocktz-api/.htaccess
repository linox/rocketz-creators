<IfModule mod_rewrite.c>
    RewriteEngine On

    # CGI/Apache no cPanel costuma apagar Authorization; o Sanctum precisa dele.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Favicon e pasta /favicon — servir de public/ sem bootstrap do Laravel
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^favicon\.svg$ public/favicon.svg [L]
    RewriteRule ^favicon/(.*)$ public/favicon/$1 [L]

    RewriteBase /
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase Request_URI "^/stream/" no-gzip dont-vary
    SetEnvIfNoCase Request_URI "^/downloads/" no-gzip dont-vary
</IfModule>