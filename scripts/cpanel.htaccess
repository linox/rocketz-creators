Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "DENY"
    Header set Content-Security-Policy "frame-ancestors 'none'"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Arquivo ou pasta reais (JS, CSS, /login/, /creators/, /creators/_/, …)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Export estático: /creators/6 → /creators/_/index.html
    RewriteRule ^creators/[^/]+/storefront-metrics /creators/_/storefront-metrics/index.html [L]
    RewriteRule ^creators/ /creators/_/index.html [L]
    RewriteRule ^campaigns/ /campaigns/_/index.html [L]
    RewriteRule ^recurring/ /recurring/_/index.html [L]
    RewriteRule ^l/_/ - [L]
    RewriteRule ^l/([^/]+)/?$ /landing-seo.php?slug=$1 [L,QSA]
    RewriteRule ^c/_/ - [L]
    RewriteRule ^c/([^/]+)/?$ /storefront-seo.php?slug=$1 [L,QSA]
</IfModule>

ErrorDocument 404 /404.html
